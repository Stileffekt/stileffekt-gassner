# GitHub Secrets für CI/CD Pipeline
# Diese Werte müssen in GitHub unter Settings → Secrets and variables → Actions angelegt werden

# SFTP Server-Konfiguration
SFTP_SERVER=ftp.kundenserver.de
SFTP_USERNAME=username
SFTP_PASSWORD=password

# Zielverzeichnis auf dem Server (mit / am Ende)
# Beispiel: /wp-content/themes/stileffekt-mein-theme/
SFTP_REMOTE_DIR=/wp-content/themes/stileffekt-*/

# Optional: Port (Standard: 22)
SFTP_PORT=22

# Optional: Protokoll (Standard: ftps)
# Mögliche Werte: ftp, ftps, ftps-legacy
SFTP_PROTOCOL=ftps
