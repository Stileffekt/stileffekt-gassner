# WordPress Configuration
WP_VERSION=7.0-php8.3-apache
WP_PORT=8080
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=true
SCRIPT_DEBUG=true

# WordPress Installation
WP_TITLE="WordPress Development Environment"
WP_ADMIN_USER="admin"
WP_ADMIN_PASSWORD="admin"
WP_ADMIN_EMAIL="it@stileffekt.de"
WP_PUBLIC="0"

# Database Configuration
DB_NAME=wordpress
DB_USER=root
DB_PASSWORD=wordpress
DB_PORT=3306

# PHPMyAdmin
PMA_PORT=8081

# Xdebug
XDEBUG_MODE=develop,debug
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003

# Browser-Sync
BROWSER_SYNC_PORT=3012

